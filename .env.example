# ============================================================
# autonovel — OpenAI-compatible LLM config
# (originally Anthropic-only; rewritten to run on ANY OpenAI-
#  compatible endpoint: local Ollama, cloud DeepSeek, OpenRouter)
# ============================================================

# --- API endpoint ---
# Local Ollama (no key needed):
#   AUTONOVEL_API_BASE_URL=http://localhost:11434/v1
#   (running the pipeline inside Docker/containers? point at the host:
#    AUTONOVEL_API_BASE_URL=http://host.docker.internal:11434/v1)
# Cloud DeepSeek (OpenAI-compatible, needs key):
#   AUTONOVEL_API_BASE_URL=https://api.deepseek.com/v1
#   AUTONOVEL_API_KEY=sk-...
# Default: local Ollama on the same machine (Docker: use host.docker.internal)
AUTONOVEL_API_BASE_URL=http://localhost:11434/v1
AUTONOVEL_API_KEY=

# --- Models per role (writer=執筆, revision=推敲, judge=評価, review=査読) ---
# Own-AI style: draft on a cloud model, revise on another, evaluate on a
# local model. Each role resolves its own model AND base URL.
#   writer/revision -> AUTONOVEL_API_BASE_URL (shared cloud endpoint)
#   judge/review    -> AUTONOVEL_JUDGE_BASE_URL / AUTONOVEL_REVIEW_BASE_URL
# Local Ollama:
#   AUTONOVEL_WRITER_MODEL=qwen3.6:latest
#   AUTONOVEL_JUDGE_MODEL=qwen3.6:latest
#   AUTONOVEL_REVIEW_MODEL=qwen3.6:latest
# Cloud DeepSeek:
#   AUTONOVEL_WRITER_MODEL=deepseek-chat
#   AUTONOVEL_JUDGE_MODEL=deepseek-chat
#   AUTONOVEL_REVIEW_MODEL=deepseek-reasoner
# Mixed cloud draft + local evaluation:
#   AUTONOVEL_API_BASE_URL=https://ollama.com/v1
#   AUTONOVEL_WRITER_MODEL=glm-5.2:cloud
#   AUTONOVEL_REVISION_MODEL=minimax-m3:cloud
#   AUTONOVEL_JUDGE_MODEL=qwen3.8:latest
#   AUTONOVEL_JUDGE_BASE_URL=http://host.docker.internal:11434/v1
# All-cloud (recommended for speed; local models are too slow for full-chapter eval):
#   AUTONOVEL_API_BASE_URL=https://ollama.com/v1
#   AUTONOVEL_WRITER_MODEL=deepseek-v4.1-flash
#   AUTONOVEL_REVISION_MODEL=deepseek-v4.1-flash
#   AUTONOVEL_JUDGE_MODEL=deepseek-v4.1-flash
#   AUTONOVEL_REVIEW_MODEL=deepseek-v4.1-flash
#   (judge/review read the full text and reason, so use a high-performance
#    model like deepseek-v4.1-flash; minimax leaks its thinking into the output
#    and glm intermittently returns empty as revision, so avoid both for
#    writer/revision)
#   Thinking control (optional):
#     AUTONOVEL_DISABLE_THINKING=1      # sends think:False (works on glm-5.3; NOT on deepseek-v4.1-flash)
#     AUTONOVEL_REASONING_EFFORT=none   # sends reasoning_effort:"none" (needed for deepseek-v4.1-flash)
AUTONOVEL_WRITER_MODEL=qwen3.6:latest
AUTONOVEL_REVISION_MODEL=qwen3.6:latest
AUTONOVEL_JUDGE_MODEL=qwen3.6:latest
AUTONOVEL_REVIEW_MODEL=qwen3.6:latest

# --- 評価役（judge）は writer と別系統にする（2026-10-03 の A/B 実測・2ラウンド） ---
# 同じ2章（生原稿 < 人手で仕上げた章）を5モデルに採点させた（点数は 生 / 仕上げ）。
# 第1ラウンドは評価プロンプトに回答言語の指定が無く、英語で返るモデルがあった。
# 第2ラウンドは llm.py が全 judge/review 呼び出しに「回答は日本語で」を付けた状態。
#                         言語指定なし            言語指定あり
#   gemma4:31b-cloud   英語 4.0/5.8      → 日本語 4.0/6.8   2回とも順位一致・最速(7秒)
#   kimi-k3            日本語 5.0/5.8    → 日本語 6.0/6.8   2回とも順位一致・指摘が最も具体的(推奨)
#   gpt-oss:120b       英語 6.0/4.8(逆転) → 日本語 5.0/5.8  一致
#   deepseek-v4.1-flash 英語 3.0/4.8     → 日本語 5.0/4.8  逆転
#   glm-5.3            日本語 4.0/失敗   → 日本語 4.0/失敗  2回連続で出力が壊れた
# 注意: 同じ章でも実行ごとに点が最大1点動き、順位が入れ替わるモデルもある。1回の結果で決めない。
# 同じモデルに書かせて採点させると自分のクセを見逃すので、writer とは別系統にする。
#AUTONOVEL_JUDGE_MODEL=kimi-k3

# --- Optional: fal.ai cover art (Nano Banana 2) ---
# FAL_KEY=your-fal-api-key-here

# --- Optional: ElevenLabs audiobook ---
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
