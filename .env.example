# ============================================================
# autonovel — OpenAI-compatible LLM config
# (originally Anthropic-only; rewritten to run on ANY OpenAI-
#  compatible endpoint: local Ollama, cloud DeepSeek, OpenRouter)
# ============================================================

# --- API endpoint ---
# Local Ollama (no key needed):
#   AUTONOVEL_API_BASE_URL=http://localhost:11434/v1
#   (running the pipeline inside Docker/containers? point at the host:
#    AUTONOVEL_API_BASE_URL=http://host.docker.internal:11434/v1)
# Cloud DeepSeek (OpenAI-compatible, needs key):
#   AUTONOVEL_API_BASE_URL=https://api.deepseek.com/v1
#   AUTONOVEL_API_KEY=sk-...
# Default: local Ollama on the same machine (Docker: use host.docker.internal)
AUTONOVEL_API_BASE_URL=http://localhost:11434/v1
AUTONOVEL_API_KEY=

# --- Models per role (writer=執筆, revision=推敲, judge=評価, review=査読) ---
# Own-AI style: draft on a cloud model, revise on another, evaluate on a
# local model. Each role resolves its own model AND base URL.
#   writer/revision -> AUTONOVEL_API_BASE_URL (shared cloud endpoint)
#   judge/review    -> AUTONOVEL_JUDGE_BASE_URL / AUTONOVEL_REVIEW_BASE_URL
# Local Ollama:
#   AUTONOVEL_WRITER_MODEL=qwen3.6:latest
#   AUTONOVEL_JUDGE_MODEL=qwen3.6:latest
#   AUTONOVEL_REVIEW_MODEL=qwen3.6:latest
# Cloud DeepSeek:
#   AUTONOVEL_WRITER_MODEL=deepseek-chat
#   AUTONOVEL_JUDGE_MODEL=deepseek-chat
#   AUTONOVEL_REVIEW_MODEL=deepseek-reasoner
# Mixed cloud draft + local evaluation:
#   AUTONOVEL_API_BASE_URL=https://ollama.com/v1
#   AUTONOVEL_WRITER_MODEL=glm-5.2:cloud
#   AUTONOVEL_REVISION_MODEL=minimax-m3:cloud
#   AUTONOVEL_JUDGE_MODEL=qwen3.8:latest
#   AUTONOVEL_JUDGE_BASE_URL=http://host.docker.internal:11434/v1
# All-cloud (recommended for speed; local models are too slow for full-chapter eval):
#   AUTONOVEL_API_BASE_URL=https://ollama.com/v1
#   AUTONOVEL_WRITER_MODEL=deepseek-v4.1-flash
#   AUTONOVEL_REVISION_MODEL=deepseek-v4.1-flash
#   AUTONOVEL_JUDGE_MODEL=deepseek-v4.1-flash
#   AUTONOVEL_REVIEW_MODEL=deepseek-v4.1-flash
#   (judge/review read the full text and reason, so use a high-performance
#    model like deepseek-v4.1-flash; minimax leaks its thinking into the output
#    and glm intermittently returns empty as revision, so avoid both for
#    writer/revision)
#   Thinking control (optional):
#     AUTONOVEL_DISABLE_THINKING=1      # sends think:False (works on glm-5.3; NOT on deepseek-v4.1-flash)
#     AUTONOVEL_REASONING_EFFORT=none   # sends reasoning_effort:"none" (needed for deepseek-v4.1-flash)
AUTONOVEL_WRITER_MODEL=qwen3.6:latest
AUTONOVEL_REVISION_MODEL=qwen3.6:latest
AUTONOVEL_JUDGE_MODEL=qwen3.6:latest
AUTONOVEL_REVIEW_MODEL=qwen3.6:latest

# --- 評価役（judge）は writer と別系統にする（2026-10-03 の A/B 実測・2ラウンド） ---
# 同じ2章（生原稿 < 人手で仕上げた章）を5モデルに採点させた（点数は 生 / 仕上げ）。
# 第1ラウンドは評価プロンプトに回答言語の指定が無く、英語で返るモデルがあった。
# 第2ラウンドは llm.py が全 judge/review 呼び出しに「回答は日本語で」を付けた状態。
#                         言語指定なし            言語指定あり
#   gemma4:31b-cloud   英語 4.0/5.8      → 日本語 4.0/6.8   2回とも順位一致・最速(7秒)
#   kimi-k3            日本語 5.0/5.8    → 日本語 6.0/6.8   2回とも順位一致・指摘が最も具体的(推奨)
#   gpt-oss:120b       英語 6.0/4.8(逆転) → 日本語 5.0/5.8  一致
#   deepseek-v4.1-flash 英語 3.0/4.8     → 日本語 5.0/4.8  逆転
#   glm-5.3            日本語 4.0/失敗   → 日本語 4.0/失敗  2回連続で出力が壊れた
# 注意: 同じ章でも実行ごとに点が最大1点動き、順位が入れ替わるモデルもある。1回の結果で決めない。
# 同じモデルに書かせて採点させると自分のクセを見逃すので、writer とは別系統にする。
#AUTONOVEL_JUDGE_MODEL=kimi-k3

# --- 改訂フェーズでも文体ゲートを回す（既定 1。0 で無効） ---
# 改訂（adversarial_edit / apply_cuts / gen_revision）が本文を書き換えた直後に章ゲート6項目を通し、
# 落ちた章は元に戻す。gen_revision の改訂は「修復→それでも駄目なら元に戻す」。
#AUTONOVEL_REVISION_GATES=1

# --- 整合ゲート（既定 1。0 で無効） ---
# 機械項目=「消えた人物」（第1章に出ている定義キャラが最後の3章に出てこない）
# 審査項目=judge モデルが設定矛盾・声の逸脱・伏線の放置を引用付きで挙げ、改訂ブリーフに足す（1章約1分半）
# 費用対策（2026-10-06）: 審査は「改訂の最初のサイクルと最後のサイクル」の2回に絞る。
# サイクルごとに回したいとき（従来動作）は AUTONOVEL_CONSISTENCY_EVERY_CYCLE=1。
#AUTONOVEL_CONSISTENCY=1
#AUTONOVEL_CONSISTENCY_EVERY_CYCLE=0
#AUTONOVEL_CONSISTENCY_TIMEOUT=900

# --- 生成パラメータ（2026-10-06 実測） ---
# この接続先（ollama.com の OpenAI 互換エンドポイント）での実測結果:
#   temperature / top_p … **効かない**（temperature=0.0 でも4回とも別の文章。共通の頭は7字）
#   frequency_penalty   … **効く**（同じ語の反復が 14回 → 9回）
#   options.repeat_penalty … 効く（同じ語の反復 14回 → 8回。`repeat_penalty` を単体で送っても効かない）
#   repetition_penalty  … どちらの層にも無い名前なので効かない
# 反復の抑制が届くのは「1回の生成の中の語句ループ」まで。チャンクをまたぐ同じやり取りの
# 繰り返しには届かない（そちらは執筆プロンプトの規則と「使用済み台詞」で抑える）。
# 既定は未設定（送らない）。日本語の文章を壊さないよう、まず 0.3〜0.5 程度から。
#AUTONOVEL_FREQUENCY_PENALTY=0.5
#AUTONOVEL_REPEAT_PENALTY=1.1
#AUTONOVEL_TOP_P=0.9

# --- ローカルの Ollama を判定（judge）に使う（2026-10-07 実測・実装済み） ---
# 接続先が :11434（ローカルの Ollama）のとき、llm.py は**ネイティブ /api/chat** に切り替える。
# 理由: /v1（OpenAI 互換）経由では think も options も**無視される**ため。
#   - 思考モデル（例 gemma4:12b）は出力枠を全部「思考」に食われ、本文が空で返る
#     → 判定は毎回 JSON 解析に失敗し、走行が止まる（実測: 6回とも 入力15,781＋出力16,000＝本文0字）
#   - ネイティブなら think を切れて、30秒・約1,300トークンで JSON が返る（実測）
#AUTONOVEL_OLLAMA_THINK=0          # 既定 0（思考を切る）。1 で思考させる
#AUTONOVEL_NATIVE_OLLAMA=1         # 自動判定を上書きしたいとき（11434 以外のローカル用）
# num_ctx: ローカルの Modelfile は 16,384 のことがあり、判定プロンプト（実測15,781トークン）で
# 出力枠が600トークンしか残らず**必ず切れる**。ネイティブ経由ならこの env が効く。
#AUTONOVEL_NUM_CTX=32768

# --- 評価側の障害で止まったとき、書けた原稿を書き直さない（2026-10-07 実装） ---
# 既定 0。1 にすると chapters/ch_NN.md があれば作り直さず評価から再開する。
# 付けないと、判定側の障害で停止したあとの再開で**同じ章を丸ごと書き直す**（実測 145,000トークン）。
#AUTONOVEL_REUSE_DRAFT=1

# --- 章の合格ライン（既定 6.0） ---
# 本家の仕様は 6.0。fork は 4.0 で走らせていたが、判定を**手元のローカルモデル**に替えると
# 点が甘く出る（実測: 却下された生原稿 4.7 / 人手で仕上げた章 7.8 / 走行中の初稿 8.0）ため
# 6.0 に戻した。上げすぎると作り直しが増えて高くつく（1章 ≈ 145,000トークン）。
#AUTONOVEL_CHAPTER_THRESHOLD=6.0

# --- 判定1回に許す時間（既定 300秒）---
# 2026-10-08 実測: 手元のローカルモデルが GPU に載らず CPU で動くと（5.2トークン/秒）
# 1回が十数分かかり、300秒で切れて「評価の失敗」として走行が停止した。
# 遅い判定を使うときは上げる（例: AUTONOVEL_EVAL_TIMEOUT=900）。
#AUTONOVEL_EVAL_TIMEOUT=900

# --- 一対比較（Elo）で章の採否を決める（既定 1。0 で無効） ---
# 絶対点が下がったときだけ、旧版と新版を両方の順序で比べる（両順序で勝てば採用）。
# 判定と Elo 表は edit_logs/elo.tsv に残る。
#AUTONOVEL_ELO_DECIDE=1
#AUTONOVEL_ELO_TIMEOUT=600

# --- 強みの移植（改訂の向きを逆にする＝天井を上げる。既定 1。0 で無効） ---
# パネルの「最も良い場面」から効いている型を言語化し、弱い章へ移植する指示書を作る
# 1サイクルあたり: 型の言語化1回 + 対象章ぶん（--max-briefs の上限まで）
#AUTONOVEL_STRENGTH=1
#AUTONOVEL_STRENGTH_MAX_BRIEFS=2
#AUTONOVEL_STRENGTH_TIMEOUT=900

# --- 長丁場の運転を守る（一時的な失敗で捨てない） ---
# 上限(429)・混雑(5xx)・通信断・タイムアウトを指数バックオフで待ってやり直す
#AUTONOVEL_LLM_RETRIES=5
#AUTONOVEL_LLM_BACKOFF=15
# 消費量の記録（1呼び出し1行のTSV→edit_logs/llm_usage.tsv）。0 で無効
#AUTONOVEL_USAGE_LOG=
# 429(上限)が連続したら edit_logs/STOP_QUOTA.txt を置いてパイプラインを止める（既定20回）
#AUTONOVEL_QUOTA_STREAK=20
# 判定(judge)の出力上限。解釈できない応答なら上限を上げて1回やり直す
#AUTONOVEL_JUDGE_MAX_TOKENS=6000
#AUTONOVEL_JUDGE_MAX_TOKENS_ESCALATED=32000
# 同じ入力の評価は再利用（判定モデルを呼ばない）。0 で無効
#AUTONOVEL_JUDGE_CACHE=1
# 判定に送る各文書の上限文字数（0＝無制限）。長い設定を切って費用を抑える
#AUTONOVEL_JUDGE_DOC_CHARS=0
# 設定が合格点に届かないまま何周続いたら止めるか
#AUTONOVEL_FOUNDATION_PLATEAU_ITERS=4
# 段階実行: 1回の実行で何章まで書くか（0=残り全部）。章ごとに保存されるので、止めても
# 同じコマンドで続きから進む（大量に消費する前に区切って様子を見るため）
#AUTONOVEL_MAX_CHAPTERS=3
# 使用率を監視して自動で待機・再開（ollama.com の /api/usage を使う）
#   python quota_guard.py --session-limit 0.90 --weekly-limit 0.95 -- uv run python run_pipeline.py

# --- Optional: fal.ai cover art (Nano Banana 2) ---
# FAL_KEY=your-fal-api-key-here

# --- Optional: ElevenLabs audiobook ---
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
